<?xml version="1.0" encoding="utf-8"?>
<!-- Trash and kept lists hold MediaStore IDs, which point at different photos on another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bracket.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bracket.xml" />
    </device-transfer>
</data-extraction-rules>
